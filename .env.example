# Copy this file to `.env` and edit it (the installers and the web UI's Settings do this for you).
# `.env` is git-ignored; real environment variables override it. Another file: LEMMATA_ENV_FILE=/path/to/file.

# --- Model endpoint ------------------------------------------------------------------------------
# Default: the DeepSeek API. Get a key at https://platform.deepseek.com (API keys).
LEMMATA_API_KEY=
# LEMMATA_MODEL=deepseek-v4-flash        # or deepseek-v4-pro (stronger, slower, more expensive)
# LEMMATA_BASE_URL=https://api.deepseek.com
# LEMMATA_API_STYLE=deepseek             # deepseek | vllm | openai
# LEMMATA_REASONING_EFFORT=              # e.g. high; sent with thinking requests when set

# A local vLLM server with a Qwen-style chat template instead:
# LEMMATA_BASE_URL=http://localhost:8000/v1
# LEMMATA_API_STYLE=vllm
# LEMMATA_MODEL=<model name served by vLLM>
# Any other OpenAI-compatible endpoint: LEMMATA_API_STYLE=openai (thinking is then up to the model).

# --- Concurrency ---------------------------------------------------------------------------------
# Concurrent thinking requests and concurrent non-thinking (repair / search-query) requests.
LEMMATA_LLM_JOBS=6
LEMMATA_QUICK_JOBS=2
# Concurrent Lean compilations (each uses about one CPU core and 1-2 GB of RAM). Default: half the CPU cores, at most 10.
# LEMMATA_COMPILE_JOBS=4

# --- Paths (optional; defaults are relative to the project root) ---------------------------------
# PUTNAMBENCH_DIR=benchmarks/PutnamBench/lean4/src
# LEMMATA_RUNS_DIR=runs
# LEMMATA_WORK_DIR=.work
# LEMMATA_CONFIG=config/default.json
