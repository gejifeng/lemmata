# Copy this file to `.env` and edit it. `.env` is git-ignored; real environment variables override it.
# Another file can be used with LEAN_PROVER_ENV_FILE=/path/to/file.

# --- Model endpoint (required) -------------------------------------------------------------
# Any OpenAI-compatible /chat/completions server (vLLM, SGLang, a hosted API, ...).
LEAN_PROVER_BASE_URL=http://localhost:8000/v1
# Model name as the server knows it.
LEAN_PROVER_MODEL=
# Sent as `Authorization: Bearer ...` when non-empty.
LEAN_PROVER_API_KEY=

# --- Concurrency ---------------------------------------------------------------------------
# Concurrent thinking requests and concurrent non-thinking (repair / search-query) requests.
# Keep their sum at or below the number of requests your server runs in parallel.
LEAN_PROVER_LLM_JOBS=6
LEAN_PROVER_QUICK_JOBS=2
# Concurrent Lean compilations (each uses about one CPU core and 1-2 GB of RAM).
LEAN_PROVER_COMPILE_JOBS=10

# --- Paths (optional; defaults are relative to the project root) ---------------------------
# PUTNAMBENCH_DIR=benchmarks/PutnamBench/lean4/src
# LEAN_PROVER_RUNS_DIR=runs
# LEAN_PROVER_WORK_DIR=.work
# LEAN_PROVER_CONFIG=config/default.json
