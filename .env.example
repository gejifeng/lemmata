# Copy this file to `.env` and edit it (the installers and the web UI's Settings do this for you).
# `.env` is git-ignored; real environment variables override it. Another file: LEAN_PROVER_ENV_FILE=/path/to/file.

# --- Model endpoint ------------------------------------------------------------------------------
# Default: the DeepSeek API. Get a key at https://platform.deepseek.com (API keys).
LEAN_PROVER_API_KEY=
# LEAN_PROVER_MODEL=deepseek-v4-flash        # or deepseek-v4-pro (stronger, slower, more expensive)
# LEAN_PROVER_BASE_URL=https://api.deepseek.com
# LEAN_PROVER_API_STYLE=deepseek             # deepseek | vllm | openai
# LEAN_PROVER_REASONING_EFFORT=              # e.g. high; sent with thinking requests when set

# A local vLLM server with a Qwen-style chat template instead:
# LEAN_PROVER_BASE_URL=http://localhost:8000/v1
# LEAN_PROVER_API_STYLE=vllm
# LEAN_PROVER_MODEL=<model name served by vLLM>
# Any other OpenAI-compatible endpoint: LEAN_PROVER_API_STYLE=openai (thinking is then up to the model).

# --- Concurrency ---------------------------------------------------------------------------------
# Concurrent thinking requests and concurrent non-thinking (repair / search-query) requests.
LEAN_PROVER_LLM_JOBS=6
LEAN_PROVER_QUICK_JOBS=2
# Concurrent Lean compilations (each uses about one CPU core and 1-2 GB of RAM). Default: half the CPU cores, at most 10.
# LEAN_PROVER_COMPILE_JOBS=4

# --- Paths (optional; defaults are relative to the project root) ---------------------------------
# PUTNAMBENCH_DIR=benchmarks/PutnamBench/lean4/src
# LEAN_PROVER_RUNS_DIR=runs
# LEAN_PROVER_WORK_DIR=.work
# LEAN_PROVER_CONFIG=config/default.json
